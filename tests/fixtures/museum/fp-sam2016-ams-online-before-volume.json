10.1201/9781315233048-5","type":"book-chapter","created":{"date-parts":[[2017,5,2]],"date-time":"2017-05-02T08:15:17Z","timestamp":1493712917000},"page":"98-147","title":["Modules Over Semiperfect Rings"],"prefix":"10.1201","member":"301","published-online":{"date-parts":[[2017,5,2]]},"container-title":["Algebras, Rings and Modules"],"issued":{"date-parts":[[2016,12,16]]},"URL":"https://doi.org/10.1201/9781315233048-5"},{"publisher":"Elsevier BV","issue":"2","short-container-title":["Journal of Algebra"],"published-print":{"date-parts":[[1977,12]]},"DOI":"10.1016/0021-8693(77)90243-5","type":"journal-article","created":{"date-parts":[[2004,12,19]],"date-time":"2004-12-19T11:23:04Z","timestamp":1103455384000},"page":"322-329","title":["Rings with infinitely many indecomposable periodic Gorenstein modules"],"prefix":"10.1016","volume":"49","author":[{"given":"Mark","family":"Ramras","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"78","container-title":["Journal of Algebra"],"issued":{"date-parts":[[1977,12]]},"URL":"https://doi.org/10.1016/0021-8693(77)90243-5","ISSN":["0021-8693"]}],"items-per-page":10,"query":{"start-index":0,"search-terms":null}}}},{"source":"crossref","key":"api.crossref.org/works/10.1090/tran/6355","kind":"positive","payload":{"status":"ok","message-type":"work","message-version":"1.0.0","message":{"indexed":{"date-parts":[[2026,10,8]],"date-time":"2026-10-08T09:33:51Z","timestamp":1791452031112,"version":"4.3.3"},"reference-count":27,"publisher":"American Mathematical Society (AMS)","issue":"2","license":[{"start":{"date-parts":[[2016,6,17]],"date-time":"2016-06-17T00:00:00Z","timestamp":1466121600000},"content-version":"am","delay-in-days":366,"URL":"https://www.ams.org/publications/copyright-and-permissions"}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["Trans. Amer. Math. Soc."],"abstract":"<p>\n                    Consider the polynomial ring in countably infinitely many variables over a field of characteristic zero, together with its natural action of the infinite general linear group\n                    <inline-formula content-type=\"math/mathml\">\n                      <mml:math xmlns:mml=\"http://www.w3.org/1998/Math/MathML\" alttext=\"upper G\">\n                        <mml:semantics>\n                          <mml:mi>G</mml:mi>\n                          <mml:annotation encoding=\"application/x-tex\">G</mml:annotation>\n                        </mml:semantics>\n                      </mml:math>\n                    </inline-formula>\n                    . We study the algebraic and homological properties of finitely generated modules over this ring that are equipped with a compatible\n                    <inline-formula content-type=\"math/mathml\">\n                      <mml:math xmlns:mml=\"http://www.w3.org/1998/Math/MathML\" alttext=\"upper G\">\n                        <mml:semantics>\n                          <mml:mi>G</mml:mi>\n                          <mml:annotation encoding=\"application/x-tex\">G</mml:annotation>\n                        </mml:semantics>\n                      </mml:math>\n                    </inline-formula>\n                    -action. We define and prove finiteness properties for analogues of Hilbert series, systems of parameters, depth, local cohomology, Koszul duality, and regularity. We also show that this category is built out of a simpler, more combinatorial, quiver category which we describe explicitly.\n                  </p>\n                  <p>Our work is motivated by recent papers in the literature which study finiteness properties of infinite polynomial rings equipped with group actions. (For example, the paper by Church, Ellenberg and Farb on the category of FI-modules, which is equivalent to our category.) Along the way, we see several connections with the character polynomials from the representation theory of the symmetric groups. Several examples are given to illustrate that the invariants we introduce are explicit and computable.</p>","DOI":"10.1090/tran/6355","type":"journal-article","created":{"date-parts":[[2015,6,17]],"date-time":"2015-06-17T09:01:36Z","timestamp":1434531696000},"page":"1097-1158","source":"Crossref","is-referenced-by-count":78,"special_numbering":"969","title":["GL-equivariant modules over polynomial rings in infinitely many variables"],"prefix":"10.1090","volume":"368","author":[{"given":"Steven","family":"Sam","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Andrew","family":"Snowden","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"14","published-online":{"date-parts":[[2015,6,17]]},"reference":[{"key":"1","first-page":"21","article-title":"Differential operators on the base affine space and a study of 𝔤-modules","author":"Bernšteĭn, I. N.","year":"1975"},{"key":"2","series-title":"Encyclopedia of Mathematics and its Applications","isbn-type":"print","volume-title":"Handbook of categorical algebra. 2","volume":"51","author":"Borceux, Francis","year":"1994","ISBN":"https://id.crossref.org/isbn/052144179X"},{"key":"3","unstructured":"[CEF] Thomas Church, Jordan Ellenberg, and Benson Farb, FI-modules: a new approach to stability for 𝑆_{𝑛}-representations, arXiv:1204.4533v2."},{"issue":"2","key":"4","doi-asserted-by":"publisher","first-page":"129","DOI":"10.1007/BF01392548","article-title":"Young diagrams and determinantal varieties","volume":"56","author":"de Concini, C.","year":"1980","journal-title":"Invent. Math.","ISSN":"https://id.crossref.org/issn/0020-9910","issn-type":"print"},{"issue":"1","key":"5","doi-asserted-by":"publisher","first-page":"243","DOI":"10.1016/j.aim.2009.08.008","article-title":"Finiteness for the 𝑘-factor model and chirality varieties","volume":"223","author":"Draisma, Jan","year":"2010","journal-title":"Adv. Math.","ISSN":"https://id.crossref.org/issn/0001